#include "ui/menudef.h"
#include "ui_mp/main.inc"
#include "ui_mp/sd.inc"

// Supply Drops: opening a drop. The crate shakes, opens in the colour of the best variant inside, and the variants
// come out one by one, the best one last. sd_main runs "sd_open" before opening this menu.

#define MENU_NAME					"sd_reveal"

// The animation is driven by the game (SupplyDrops.cpp sets these dvars every frame while it plays): the menu only
// reads them, which keeps it light
#define V(name)						dvarint( name )
#define F(name)						( dvarint( name ) / 100.0 )

#define CARD_W						180
#define CARD_Y						(0 - 168)

// A card: it comes up and fades in at its time, with a flash in its colour
// A card: it comes up and fades in at its time, with a flash in its colour
#define SD_REVEAL_CARD(i, P, X) \
	SD_CARD(P, X, CARD_Y, CARD_W, HORIZONTAL_ALIGN_CENTER, VERTICAL_ALIGN_CENTER, F( P + "_a" ), V( P + "_dy" ), when( V( P + "_on" ) && V( P + "_a" ) > 0 )) \
	itemDef \
	{ \
		rect				X CARD_Y CARD_W SD_CARD_H(CARD_W) HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER \
		style				WINDOW_STYLE_SHADER \
		background			"white" \
		forecolor			1 1 1 0 \
		decoration \
		visible				when( V( P + "_fl" ) > 0 ) \
		exp					forecolor r ( SD_COLOR_R(P) ) \
		exp					forecolor g ( SD_COLOR_G(P) ) \
		exp					forecolor b ( SD_COLOR_B(P) ) \
		exp					forecolor a ( F( P + "_fl" ) ) \
	}

{
	menuDef
	{
		name						MENU_NAME
		fullscreen					1
		rect						0 0 640 480
		foreColor					1 1 1 1
		focusColor					1 1 1 1
		soundLoop					"music_mainmenu_mp"
		fadeCycle					1
		fadeClamp					1
		fadeAmount					0.1

		onOpen
		{
			setfocus "sd_rv_continue";
			play "mp_level_up";
		}
		onEsc
		{
			close self;
		}

		// --- Background ---------------------------------------------------------------------------------------------
		SD_RECT(0, 0, 640, 480, HORIZONTAL_ALIGN_FULLSCREEN, VERTICAL_ALIGN_FULLSCREEN, 0.03, 0.035, 0.04, 1, 1)
		itemDef
		{
			rect					0 0 1280 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			style					WINDOW_STYLE_SHADER
			forecolor				1 1 1 0.35
			background				"mw2_popup_bg_fogscroll"
			decoration
			visible					1
			exp						rect x ( 0 - ( ( float( milliseconds( ) % 60000 ) / 60000 ) * 640 ) )
		}
		// The glow of the best variant, from the moment the crate opens
		itemDef
		{
			rect					(0 - 427) (0 - 140) 854 280 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER
			style					WINDOW_STYLE_SHADER
			background				"white"
			forecolor				1 1 1 0
			decoration
			visible					1
			exp						forecolor r ( SD_COLOR_R("sd_rv_best") )
			exp						forecolor g ( SD_COLOR_G("sd_rv_best") )
			exp						forecolor b ( SD_COLOR_B("sd_rv_best") )
			exp						forecolor a ( F( "sd_rv_glow" ) )
		}

		// --- Title ------------------------------------------------------------------------------------------------
		SD_TEXT((0 - 300), (0 - 222), 600, 30, HORIZONTAL_ALIGN_CENTER, VERTICAL_ALIGN_CENTER, 9, 0.6, ITEM_ALIGN_TOP_CENTER, 1, 1, 1, 1, dvarstring( "sd_rv_title" ), 1)
		SD_RECT((0 - 120), (0 - 190), 240, 2, HORIZONTAL_ALIGN_CENTER, VERTICAL_ALIGN_CENTER, 1, 0.75, 0.2, 0.8, 1)

		// --- The crate ------------------------------------------------------------------------------------------
		// A beam of light in the colour of the best variant when the lid comes off
		itemDef
		{
			rect					(0 - 30) (0 - 240) 60 230 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER
			style					WINDOW_STYLE_SHADER
			background				"white"
			forecolor				1 1 1 0
			decoration
			visible					when( V( "sd_rv_beam_a" ) > 0 )
			exp						rect x ( V( "sd_rv_beam_x" ) )
			exp						rect w ( V( "sd_rv_beam_w" ) )
			exp						forecolor r ( SD_COLOR_R("sd_rv_best") )
			exp						forecolor g ( SD_COLOR_G("sd_rv_best") )
			exp						forecolor b ( SD_COLOR_B("sd_rv_best") )
			exp						forecolor a ( F( "sd_rv_beam_a" ) )
		}
		SD_CRATE(0, 20, 1.6, HORIZONTAL_ALIGN_CENTER, VERTICAL_ALIGN_CENTER, V( "sd_rv_adv" ), F( "sd_rv_crate_a" ), ( V( "sd_rv_shake" ) / 10.0 ), 0, V( "sd_rv_lid" ), when( V( "sd_rv_crate_a" ) > 0 ))

		// The flash when it opens
		itemDef
		{
			rect					0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			style					WINDOW_STYLE_SHADER
			background				"white"
			forecolor				1 1 1 0
			decoration
			visible					when( V( "sd_rv_flash" ) > 0 )
			exp						forecolor a ( F( "sd_rv_flash" ) )
		}

		// --- The variants -----------------------------------------------------------------------------------------
		SD_REVEAL_CARD(0, "sd_rv0", (0 - 285))
		SD_REVEAL_CARD(1, "sd_rv1", (0 - 90))
		SD_REVEAL_CARD(2, "sd_rv2", 105)

		// The COD Points that came with it
		SD_TEXT((0 - 300), 148, 600, 18, HORIZONTAL_ALIGN_CENTER, VERTICAL_ALIGN_CENTER, 9, 0.4, ITEM_ALIGN_TOP_CENTER, 0.35, 0.75, 1, 1, dvarstring( "sd_rv_bonus" ) + "      ^7Equip your variants in the Armory or in Create a Class", when( V( "sd_rv_done" ) ))

		// --- Buttons: continue (skips the animation while it plays), open another of the same kind -----------------
		SD_CENTER_BUTTON("sd_rv_continue", 176, "CONTINUE", if ( V( "sd_rv_done" ) == 0 ) { execnow "sd_reveal_skip"; } else { close self; }, 1)
		SD_CENTER_BUTTON("sd_rv_again", 200, "OPEN ANOTHER", execnow "sd_open 0"; setfocus "sd_rv_continue";, when( V( "sd_rv_done" ) && V( "sd_rv_adv" ) == 0 && V( "sd_drops" ) > 0 ))
		SD_CENTER_BUTTON("sd_rv_again_adv", 200, "OPEN ANOTHER", execnow "sd_open 1"; setfocus "sd_rv_continue";, when( V( "sd_rv_done" ) && V( "sd_rv_adv" ) == 1 && V( "sd_adv" ) > 0 ))
	}
}
