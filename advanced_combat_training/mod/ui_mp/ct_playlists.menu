#include "ui/menudef.h"
#include "ui_mp/main.inc"

// Combat Training: the playlists. Each button starts its playlist (CombatTraining.cpp, combat_training/playlists.txt);
// the panel on the right shows the one in focus.

#define MENU_NAME					"ct_playlists"
#define MENU_MUSIC					"music_mainmenu_mp"
#define MENU_TITLE					"ADVANCED COMBAT TRAINING"

#undef CHOICE_GROUP
#define CHOICE_GROUP				MENU_NAME

#undef TEXTSIZE_TITLE
#define TEXTSIZE_TITLE				0.4

#define CHOICE_Y(i)					(96 + (i * 20))
#define CHOICE_ORIGIN(i)			-64 CHOICE_Y(i)
#define CHOICE_RECT(i)				CHOICE_ORIGIN(i) 336 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP

#define HR_ORIGIN(i)				0 (CHOICE_Y(i) - 0.5)
#define HR_RECT(i)					HR_ORIGIN(i) 216 1 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP

#define PX							(0 - 300)
#define PW							290

// A playlist: its button, and what the panel shows while it is in focus
#define CT_PLAYLIST(itemIndex, buttonName, textArg, startCmd, descArg, imageArg, playersArg, modesArg) \
	itemDef \
	{ \
		name				buttonName \
		rect				CHOICE_RECT(itemIndex) \
		forecolor			CHOICE_TEXTCOLOR \
		style				WINDOW_STYLE_FILLED \
		background			HIGHLIGHT_SHADER_ART \
		group				"mw2_button" \
		type				ITEM_TYPE_BUTTON \
		textAlign			ITEM_ALIGN_TOP_RIGHT \
		textAlignX			-60 \
		textScale			CHOICE_TEXTSIZE \
		textFont			CHOICE_TEXTFONT \
		text				textArg \
		visible				1 \
		mouseEnter \
		{ \
			play			CHOICE_FOCUS_SOUND; \
		} \
		onFocus \
		{ \
			setItemColor	self backColor 0 0 0 1; \
			setLocalVarBool	ui_menuAButton 1; \
			setLocalVarFloat ui_popupYPos 0; \
			setLocalVarString ui_hint_text "Start the playlist. Supply Drops are earned by playing."; \
			setLocalVarString ui_ct_name textArg; \
			setLocalVarString ui_ct_desc descArg; \
			setLocalVarString ui_ct_image imageArg; \
			setLocalVarString ui_ct_players playersArg; \
			setLocalVarString ui_ct_modes modesArg; \
		} \
		leaveFocus \
		{ \
			setItemColor	self backColor 0 0 0 0; \
			setLocalVarString ui_hint_text "@NULL_EMPTY"; \
		} \
		action \
		{ \
			play			CHOICE_CLICK_SOUND; \
			exec			startCmd; \
			close			self; \
		} \
	}

#define CT_TEXT(y, h, font, scale, a, textExpr) \
	itemDef \
	{ \
		rect				(PX + 10) y (PW - 20) h HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_TOP \
		forecolor			1 1 1 a \
		textfont			font \
		textscale			scale \
		textalign			ITEM_ALIGN_TOP_LEFT \
		decoration \
		autowrapped \
		visible				when( localvarstring( "ui_ct_name" ) != "" ) \
		exp					text ( textExpr ) \
	}

{
	menuDef
	{
		name						MENU_NAME
		fullscreen					1
		rect						0 0 640 480
		foreColor					CHOICE_TEXTCOLOR
		focusColor					CHOICE_TEXTCOLOR
		soundLoop					MENU_MUSIC
		fadeCycle					1
		fadeClamp					1
		fadeAmount					0.1

		MENU_ON_OPEN(setLocalVarString ui_hint_text ""; setLocalVarString ui_ct_name "";)
		MENU_ON_ESC(close self;)

		#define BACKGROUND_IW4
		#include "ui_mp/bg.inc"

		MENU_CHOICE_TITLE_VIS(MENU_TITLE, 58, 1)

		CT_PLAYLIST(0, ct_war, "TEAM DEATHMATCH", "ct_start war", "6 vs 6. The first team to reach the score limit wins.", "preview_mp_highrise", "6 vs 6", "Team Deathmatch")
		CT_PLAYLIST(1, ct_dm, "FREE-FOR-ALL", "ct_start dm", "Every man for himself. The top three players win.", "preview_mp_rust", "8 players", "Free-for-all")
		CT_PLAYLIST(2, ct_dom, "DOMINATION", "ct_start dom", "Capture and hold the flags to earn points.", "preview_mp_terminal", "6 vs 6", "Domination")
		CT_PLAYLIST(3, ct_groundwar, "GROUND WAR", "ct_start groundwar", "Big matches on the large maps.", "preview_mp_afghan", "9 vs 9", "Domination, Team Deathmatch, Headquarters")
		CT_PLAYLIST(4, ct_hq, "HEADQUARTERS PRO", "ct_start hq", "Capture and defend the headquarters. No respawn while your team holds it.", "preview_mp_favela", "6 vs 6", "Headquarters Pro")
		CT_PLAYLIST(5, ct_sd, "SEARCH AND DESTROY", "ct_start sd", "No respawns. Plant the bomb or defend the targets.", "preview_mp_estate", "5 vs 5", "Search and Destroy")
		CT_PLAYLIST(6, ct_sab, "SABOTAGE", "ct_start sab", "One bomb for both teams: take it to the enemy target.", "preview_mp_quarry", "6 vs 6", "Sabotage")
		CT_PLAYLIST(7, ct_demo, "DEMOLITION", "ct_start demo", "Attack or defend two targets, with respawns.", "preview_mp_invasion", "6 vs 6", "Demolition")
		CT_PLAYLIST(8, ct_ctf, "CAPTURE THE FLAG", "ct_start ctf", "Steal the enemy flag and bring it home.", "preview_mp_derail", "6 vs 6", "Capture the Flag")
		CT_PLAYLIST(9, ct_merc, "MERCENARY", "ct_start mercenary", "A mix of modes, like the Mercenary playlist online.", "preview_mp_subbase", "6 vs 6", "Team Deathmatch, Domination, Headquarters, Sabotage, Demolition")
		MENU_CHOICE_HORIZONTAL_LINE_VIS(10, 1)
		CT_PLAYLIST(10, ct_hcwar, "HARDCORE TEAM DEATHMATCH", "ct_start hc_war", "No HUD, less health and friendly fire.", "preview_mp_checkpoint", "6 vs 6", "Team Deathmatch (Hardcore)")
		CT_PLAYLIST(11, ct_hcsd, "HARDCORE SEARCH AND DESTROY", "ct_start hc_sd", "Search and Destroy in hardcore: no HUD, less health.", "preview_mp_underpass", "5 vs 5", "Search and Destroy (Hardcore)")
		MENU_CHOICE_HORIZONTAL_LINE_VIS(12, 1)
		MENU_CHOICE_BUTTON_VIS(12, ct_back, "BACK", close self;, "", 1)

		// --- The playlist in focus --------------------------------------------------------------------------------
		itemDef
		{
			rect					PX 28 PW 356 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_TOP
			style					WINDOW_STYLE_SHADER
			background				"white"
			forecolor				0 0 0 0.7
			decoration
			visible					when( localvarstring( "ui_ct_name" ) != "" )
		}
		itemDef
		{
			rect					PX 28 PW 2 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_TOP
			style					WINDOW_STYLE_SHADER
			background				"white"
			forecolor				1 0.75 0.2 0.9
			decoration
			visible					when( localvarstring( "ui_ct_name" ) != "" )
		}
		itemDef
		{
			rect					(PX + 10) 40 (PW - 20) 135 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_TOP
			style					WINDOW_STYLE_SHADER
			forecolor				1 1 1 1
			decoration
			visible					when( localvarstring( "ui_ct_name" ) != "" )
			exp						material ( localvarstring( "ui_ct_image" ) )
		}
		CT_TEXT(182, 22, 9, 0.42, 1, localvarstring( "ui_ct_name" ))
		CT_TEXT(208, 40, UI_FONT_SMALL, 0.32, 0.75, localvarstring( "ui_ct_desc" ))
		CT_TEXT(256, 14, UI_FONT_SMALL, 0.28, 0.55, "PLAYERS")
		CT_TEXT(270, 16, UI_FONT_SMALL, 0.34, 1, localvarstring( "ui_ct_players" ) + "  ^7(the rest are bots)")
		CT_TEXT(294, 14, UI_FONT_SMALL, 0.28, 0.55, "MODES")
		CT_TEXT(308, 40, UI_FONT_SMALL, 0.34, 1, localvarstring( "ui_ct_modes" ))
		CT_TEXT(352, 30, UI_FONT_SMALL, 0.28, 0.55, "Random maps, never one of the last few. Ranked: experience, unlocks and prestige.")

		// hint text
		itemDef
		{
			name					"hint_area"
			rect					0 380 215 18 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			foreColor				1 1 1 0.65
			textAlign				6
			textScale				CHOICE_TEXTSIZE
			textFont				UI_FONT_SMALL
			decoration
			autoWrapped
			visible					1
			exp						text ( localvarstring( "ui_hint_text" ) )
		}
	}
}
