#include "ui/menudef.h"
#include "ui_mp/main.inc"

// Combat Training: the playlists. Each button starts its playlist (CombatTraining.cpp, combat_training/playlists.txt).

#define MENU_NAME					"ct_playlists"
#define MENU_MUSIC					"music_mainmenu_mp"
#define MENU_TITLE					"ADVANCED COMBAT TRAINING"

#undef CHOICE_GROUP
#define CHOICE_GROUP				MENU_NAME

#undef TEXTSIZE_TITLE
#define TEXTSIZE_TITLE				0.4

#define CHOICE_Y(i)					(96 + (i * 20))
#define CHOICE_ORIGIN(i)			-64 CHOICE_Y(i)
#define CHOICE_RECT(i)				CHOICE_ORIGIN(i) 336 20 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP

#define HR_ORIGIN(i)				0 (CHOICE_Y(i) - 0.5)
#define HR_RECT(i)					HR_ORIGIN(i) 216 1 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP

{
	menuDef
	{
		name						MENU_NAME
		fullscreen					1
		rect						0 0 640 480
		foreColor					CHOICE_TEXTCOLOR
		focusColor					CHOICE_TEXTCOLOR
		soundLoop					MENU_MUSIC
		fadeCycle					1
		fadeClamp					1
		fadeAmount					0.1

		MENU_ON_OPEN(setLocalVarString ui_hint_text "";)
		MENU_ON_ESC(close self;)

		#define BACKGROUND_IW4
		#include "ui_mp/bg.inc"

		MENU_CHOICE_TITLE_VIS(MENU_TITLE, 58, 1)

		MENU_CHOICE_BUTTON_VIS(0, ct_war, "TEAM DEATHMATCH", exec "ct_start war"; close self;, "6 vs 6. First team to reach the score limit wins.", 1)
		MENU_CHOICE_BUTTON_VIS(1, ct_dm, "FREE-FOR-ALL", exec "ct_start dm"; close self;, "8 players, every man for himself.", 1)
		MENU_CHOICE_BUTTON_VIS(2, ct_dom, "DOMINATION", exec "ct_start dom"; close self;, "6 vs 6. Capture and hold the flags.", 1)
		MENU_CHOICE_BUTTON_VIS(3, ct_groundwar, "GROUND WAR", exec "ct_start groundwar"; close self;, "9 vs 9 in Domination, Team Deathmatch and Headquarters.", 1)
		MENU_CHOICE_BUTTON_VIS(4, ct_hq, "HEADQUARTERS", exec "ct_start hq"; close self;, "6 vs 6. Capture and defend the headquarters.", 1)
		MENU_CHOICE_BUTTON_VIS(5, ct_sd, "SEARCH AND DESTROY", exec "ct_start sd"; close self;, "5 vs 5, no respawns. Plant or defuse the bomb.", 1)
		MENU_CHOICE_BUTTON_VIS(6, ct_sab, "SABOTAGE", exec "ct_start sab"; close self;, "6 vs 6. One bomb for both teams.", 1)
		MENU_CHOICE_BUTTON_VIS(7, ct_demo, "DEMOLITION", exec "ct_start demo"; close self;, "6 vs 6. Attack or defend two targets.", 1)
		MENU_CHOICE_BUTTON_VIS(8, ct_ctf, "CAPTURE THE FLAG", exec "ct_start ctf"; close self;, "6 vs 6. Steal the enemy flag.", 1)
		MENU_CHOICE_BUTTON_VIS(9, ct_merc, "MERCENARY", exec "ct_start mercenary"; close self;, "Mixed modes, like the online Mercenary playlist.", 1)

		MENU_CHOICE_HORIZONTAL_LINE_VIS(10, 1)
		MENU_CHOICE_BUTTON_VIS(10, ct_hcwar, "HARDCORE TEAM DEATHMATCH", exec "ct_start hc_war"; close self;, "No HUD, less health, friendly fire.", 1)
		MENU_CHOICE_BUTTON_VIS(11, ct_hcsd, "HARDCORE SEARCH AND DESTROY", exec "ct_start hc_sd"; close self;, "Search and Destroy in hardcore mode.", 1)

		MENU_CHOICE_HORIZONTAL_LINE_VIS(12, 1)
		MENU_CHOICE_BUTTON_VIS(12, ct_back, "BACK", close self;, "@NULL_EMPTY", 1)

		// hint text
		itemDef
		{
			name					"hint_area"
			rect					0 380 215 18 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_TOP
			foreColor				1 1 1 0.65
			textAlign				6
			textScale				CHOICE_TEXTSIZE
			textFont				UI_FONT_SMALL
			decoration
			autoWrapped
			visible					1
			exp						text ( localvarstring( "ui_hint_text" )  )
		}
	}
}
