itemDef { name "sd_rv_continue" rect (0 - 110) 176 220 22 2 2 forecolor 1 1 1 1 style 1 background "menu_button_selection_bar" group "sd_center_buttons" type 1 textAlign 9 textScale 0.375 textFont 1 exp text ( "CONTINUE" ) visible 1 mouseEnter { play "mouse_over"; } onFocus { setItemColor self backColor 0 0 0 1; } leaveFocus { setItemColor self backColor 0 0 0 0; } action { play "mouse_click"; if ( float( milliseconds( ) - localvarint( "ui_sd_t0" ) ) < ( 1900 + 650 * ( dvarint( "sd_rv_count" ) - 1 ) + 500 ) ) { setLocalVarInt ui_sd_t0 ( milliseconds( ) - 20000 ); } else { close self; } } }
