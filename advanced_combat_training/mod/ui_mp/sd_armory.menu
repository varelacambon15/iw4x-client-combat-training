#include "ui/menudef.h"
#include "ui_mp/main.inc"
#include "ui_mp/sd.inc"

// Supply Drops: the Armory. The weapons you have variants for; the card shows the variant equipped on each.

#define MENU_NAME					"sd_armory"
#define MENU_TITLE					"ARMORY"
#include "ui_mp/sd_menu_common.inc"

#define SD_ARMORY_ROW(i, buttonName, P, weaponCmd, focusCmd) \
	SD_BUTTON(i, buttonName, dvarstring( P + "_name" ), execnow weaponCmd; open sd_variants;, execnow focusCmd;, "Choose a variant to equip on this weapon, or salvage the ones you don't want.", when( dvarstring( P + "_name" ) != "" )) \
	SD_ROW_TAG(i, "x" + dvarstring( P + "_count" ), 1, 1, 1, when( dvarstring( P + "_name" ) != "" ))

{
	menuDef
	{
		name						MENU_NAME
		fullscreen					1
		rect						0 0 640 480
		foreColor					CHOICE_TEXTCOLOR
		focusColor					CHOICE_TEXTCOLOR
		soundLoop					"music_mainmenu_mp"
		fadeCycle					1
		fadeClamp					1
		fadeAmount					0.1

		onOpen
		{
			setLocalVarString ui_hint_text "";
			setfocus "sd_aw_0";
			execnow "sd_afocus 0";
		}
		onEsc
		{
			close self;
		}

		#define BACKGROUND_IW4
		#include "ui_mp/bg.inc"

		MENU_CHOICE_TITLE_VIS(MENU_TITLE, 58, 1)

		SD_ARMORY_ROW(0, sd_aw_0, "sd_aw0", "sd_weapon 0", "sd_afocus 0")
		SD_ARMORY_ROW(1, sd_aw_1, "sd_aw1", "sd_weapon 1", "sd_afocus 1")
		SD_ARMORY_ROW(2, sd_aw_2, "sd_aw2", "sd_weapon 2", "sd_afocus 2")
		SD_ARMORY_ROW(3, sd_aw_3, "sd_aw3", "sd_weapon 3", "sd_afocus 3")
		SD_ARMORY_ROW(4, sd_aw_4, "sd_aw4", "sd_weapon 4", "sd_afocus 4")
		SD_ARMORY_ROW(5, sd_aw_5, "sd_aw5", "sd_weapon 5", "sd_afocus 5")
		SD_ARMORY_ROW(6, sd_aw_6, "sd_aw6", "sd_weapon 6", "sd_afocus 6")
		SD_ARMORY_ROW(7, sd_aw_7, "sd_aw7", "sd_weapon 7", "sd_afocus 7")
		SD_ARMORY_ROW(8, sd_aw_8, "sd_aw8", "sd_weapon 8", "sd_afocus 8")
		SD_ARMORY_ROW(9, sd_aw_9, "sd_aw9", "sd_weapon 9", "sd_afocus 9")

		// No variants yet
		SD_TEXT(0, CHOICE_Y(0), 212, 60, HORIZONTAL_ALIGN_LEFT, VERTICAL_ALIGN_TOP, UI_FONT_SMALL, 0.32, ITEM_ALIGN_TOP_RIGHT, 1, 1, 1, 0.7, "No variants yet.", when( dvarint( "sd_aw_count" ) == 0 ))
		SD_TEXT(0, CHOICE_Y(1), 212, 60, HORIZONTAL_ALIGN_LEFT, VERTICAL_ALIGN_TOP, UI_FONT_SMALL, 0.32, ITEM_ALIGN_TOP_RIGHT, 1, 1, 1, 0.7, "Open Supply Drops to get some.", when( dvarint( "sd_aw_count" ) == 0 ))

		MENU_CHOICE_HORIZONTAL_LINE_VIS(10, 1)
		SD_BUTTON(10, sd_aw_next, "NEXT PAGE  (" + dvarstring( "sd_aw_page" ) + ")", execnow "sd_armory 1"; setfocus "sd_aw_0"; execnow "sd_afocus 0";, SD_NOP, "", when( dvarint( "sd_aw_pages" ) > 1 ))
		SD_BUTTON(11, sd_aw_salvage0, "SALVAGE ALL ENLISTED", execnow "sd_salvage_all 0";, SD_NOP, "Salvages every Enlisted variant that is not equipped, for Credits.", when( dvarint( "sd_aw_count" ) > 0 ))
		SD_BUTTON(12, sd_aw_salvage1, "SALVAGE ALL PROFESSIONAL", execnow "sd_salvage_all 1";, SD_NOP, "Salvages every Professional variant that is not equipped, for Credits.", when( dvarint( "sd_aw_count" ) > 0 ))
		MENU_CHOICE_HORIZONTAL_LINE_VIS(13, 1)
		MENU_CHOICE_BUTTON_VIS(13, sd_aw_back, "BACK", close self;, "", 1)

		SD_HINT

		// --- The panel: the weapon, with the variant it has equipped ----------------------------------------------
		SD_RECT(PX, 28, PW, 356, HORIZONTAL_ALIGN_RIGHT, VERTICAL_ALIGN_TOP, 0, 0, 0, 0.7, when( dvarint( "sd_aw_count" ) > 0 ))
		SD_CARD("sd_af", (PX + 5), 30, 280, HORIZONTAL_ALIGN_RIGHT, VERTICAL_ALIGN_TOP, 1, 0, when( dvarint( "sd_aw_count" ) > 0 ))

		SD_MESSAGE
	}
}
